static func count() -> int:
	return DATA.size()


static func at(index: int) -> RefCounted:
	if index < 0 or index >= DATA.size():
		return null
	var lvl = Level.new()
	lvl.parse(DATA[index], index)
	return lvl


static func all() -> Array:
	var out: Array = []
	for i in DATA.size():
		out.append(at(i))
	return out
